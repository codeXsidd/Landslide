{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SRTMDownloadManifest",
  "description": "Schema for OpenTopography SRTM GL1 DEM download manifest records.",
  "type": "object",
  "properties": {
    "manifest_version": {
      "type": "string",
      "example": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_tiles_planned": {
      "type": "integer",
      "minimum": 0
    },
    "total_tiles_downloaded": {
      "type": "integer",
      "minimum": 0
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tile_id",
          "xmin",
          "ymin",
          "xmax",
          "ymax",
          "dataset",
          "output_format",
          "download_timestamp",
          "filename",
          "status",
          "file_size"
        ],
        "properties": {
          "tile_id": {
            "type": "string",
            "example": "Tile_A"
          },
          "xmin": {
            "type": "number",
            "minimum": -180.0,
            "maximum": 180.0
          },
          "ymin": {
            "type": "number",
            "minimum": -90.0,
            "maximum": 90.0
          },
          "xmax": {
            "type": "number",
            "minimum": -180.0,
            "maximum": 180.0
          },
          "ymax": {
            "type": "number",
            "minimum": -90.0,
            "maximum": 90.0
          },
          "approximate_area_km2": {
            "type": "number"
          },
          "dataset": {
            "type": "string",
            "example": "SRTMGL1"
          },
          "output_format": {
            "type": "string",
            "example": "GTiff"
          },
          "download_timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "filename": {
            "type": "string",
            "example": "srtm_tile_A_88_21_93_25.tif"
          },
          "filepath": {
            "type": "string",
            "example": "data/raw/terrain/dem/srtm_tile_A_88_21_93_25.tif"
          },
          "status": {
            "type": "string",
            "enum": ["COMPLETED", "SKIPPED_EXISTS", "SKIPPED_DRY_RUN", "FAILED", "OVERLAPS_EXISTING"]
          },
          "file_size": {
            "type": "integer",
            "minimum": 0
          },
          "overlaps_existing_test_tile": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "manifest_version",
    "created_at",
    "total_tiles_planned",
    "tiles"
  ]
}

.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/
backend/.venv/
backend/venv/
*.venv
venv/
ENV/
env/
.venv

# Jupyter
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*.ipynb_checkpoints/


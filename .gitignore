data/raw/**/*.geotiff
data/raw/**/*.nc
data/raw/**/*.hdf5
data/raw/**/*.pdf
*.pdf
data/processed/**/*.tif
data/processed/**/*.pkl
data/runtime/
data/raw/hydrography/

# TypeScript build info
*.tsbuildinfo

# MinIO / Object storage local
.minio/
minio_data/

# IDE
.idea/
.vscode/settings.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db


# ============================================================
# NER-SAGE Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Application
APP_ENV=development
APP_NAME=ner-sage
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Security
JWT_SECRET=CHANGE_ME_use_a_long_random_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================
# MongoDB
# ============================================================
MONGODB_URI=mongodb://nersage:nersage_pass@localhost:27017/ner_sage?authSource=ner_sage
MONGODB_DATABASE=ner_sage
MONGODB_USERNAME=nersage
MONGODB_PASSWORD=nersage_pass

# ============================================================
# Neo4j
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=nersage_neo4j_pass
NEO4J_DATABASE=neo4j

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DEFAULT_TTL=3600

# ============================================================
# Qdrant
# ============================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_DOCUMENTS=ner_sage_documents
QDRANT_COLLECTION_EVIDENCE=ner_sage_evidence

# ============================================================
# Groq API (LLM + Embeddings for RAG)
# Get your key: https://console.groq.com
# ============================================================
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# ML Configuration
# ============================================================
ML_MODEL_PATH=ml/artifacts
ML_DEFAULT_MODEL=xgb_v1
ML_CONFIDENCE_THRESHOLD=0.70
ML_HIGH_RISK_THRESHOLD=0.75
ML_MEDIUM_RISK_THRESHOLD=0.50

# ============================================================
# Simulation
# ============================================================
SIMULATION_MODE=true
DEMO_DATA_LOADED=false

# ============================================================
# NER Region Bounding Box
# ============================================================
NER_BBOX_MIN_LON=88.0
NER_BBOX_MIN_LAT=21.9
NER_BBOX_MAX_LON=97.4
NER_BBOX_MAX_LAT=29.5

# ============================================================
# OpenTopography API Key
# Get your key: https://portal.opentopography.org/
# ============================================================
OPENTOPOGRAPHY_API_KEY=

# ============================================================
# Frontend (Next.js — prefix NEXT_PUBLIC_ for browser access)
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=NER-SAGE
NEXT_PUBLIC_MAP_CENTER_LAT=25.5
NEXT_PUBLIC_MAP_CENTER_LON=92.7
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=8
